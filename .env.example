# OmniSwarm configuration (all optional; defaults shown)
OMNISWARM_OMNIROUTE_URL=http://localhost:20128/v1
OMNISWARM_DB_PATH=omniswarm.db
OMNISWARM_CONNECT_TIMEOUT=3
OMNISWARM_READ_TIMEOUT=60
OMNISWARM_MAX_CONN=20
# Optional path to the runtime settings file written by the Control Panel
OMNISWARM_RUNTIME=omniswarm.runtime.json
# Optional: only use models from these gateway providers (comma-separated prefixes).
# Empty = every provider the gateway lists.
# OMNISWARM_ALLOWED_PROVIDERS=mistral,gemini,groq
# How long a provider that can't run here (missing CLI/browser...) stays benched, seconds
# OMNISWARM_PROVIDER_UNAVAILABLE_COOLDOWN=43200
